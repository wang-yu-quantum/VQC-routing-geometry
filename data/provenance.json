        "energy_error_min": 0.01
      },
      "strict": {
        "parameter_gradient_max": 1e-07,
        "ambient_gradient_min": 0.05,
        "chi_ratio_max": 0.0001,
        "energy_error_min": 0.05
      }
    },
    "statistics": {
      "primary_unit": "routing x initialization",
      "cluster": "routing",
      "cluster_bootstrap_samples": 4000,
      "confidence_level": 0.95,
      "wilson_interval": true,
      "correlations": "exploratory Spearman, stratified by n"
